# ===== Modo =====
# demo = usa o banco de exemplo (demo.db, dados fictícios). sqlserver = banco real SL_ISS.
DB_MODE=demo

# ===== SQL Server (somente com DB_MODE=sqlserver) =====
# Leitura: usuário SOMENTE LEITURA (veja sql/preparar_banco.sql)
SQLSERVER_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=NOME_DO_SERVIDOR;DATABASE=SL_ISS;UID=usr_simples_leitura;PWD=TROCAR;ApplicationIntent=ReadOnly;ApplicationName=FiscalSimples
# Escrita (gravar confronto, tratar divergência, baixa, carga): login separado e restrito às tabelas do módulo.
# Só é usado se ESCRITA_PERMITIDA=true.
SQLSERVER_CONN_ESCRITA=

# ===== Regras de negócio =====
COD_TOM=9999               # CodTOM do município (veja dbo.tabela_tom). No demo: 9999 (fictício)
COD_MUNIC_01100=           # valor de PGDASD01100.codmunic do município (TOM ou IBGE - pendência 4). Vazio = igual ao COD_TOM
MUNICIPIO_NOME=Município Demo
TOLERANCIA_ABS=0.05        # R$ por contribuinte e PA (receita, ISS e pagamento) - pendência 10
TOLERANCIA_ALIQ=0.01       # pontos percentuais
MAX_ERRO_CARGA_PCT=5       # acima disso a carga do arquivo é revertida inteira

# ===== Travas de proteção do servidor =====
ESCRITA_PERMITIDA=         # vazio = true no demo, false no sqlserver. Só 'true' libera gravações no banco real
TIMEOUT_CONSULTA=30
MAX_SIMULTANEAS=2
TAM_PAGINA_MAX=200
MAX_UPLOAD_MB=20
USAR_NOLOCK=true
ISOLAMENTO_READ_UNCOMMITTED=true

# ===== Login (dbo.Usuario) e sessão =====
# SECRET_KEY assina o cookie de sessão; se vazio, é gerada em data/secret.key
SECRET_KEY=
SESSAO_HORAS=8
# true quando o sistema estiver atrás de HTTPS
COOKIE_SEGURO=false
